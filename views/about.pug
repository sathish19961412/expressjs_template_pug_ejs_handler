extends layouts/main.pug

block styles 
    link(rel="stylesheet", href="css/about.css")
block content
    section(id="page")
        div(class="container px-4")
            div(class="row gx-4 justify-content-center")
                div(class="col-lg-8")
                    h2 My name is Sathish. I will Practices you the follwing courses
                    if courses.length > 0
                        ul
                            each course in courses 
                                li #{course.name}
                    else
                        p(class="lead") No courses available